model Events {
    id Int @default(autoincrement()) @id
    title String @db.VarChar(250)
    description String @db.VarChar(999)
    date DateTime 
    times String
    duration Int //В МИНУТАХ
    cabinet String  
    people_count Int
    whoClasses String
    isDelete Boolean @default(false)
    prepod String 
    createdAt DateTime @default(now())
    //Связи
    eventSpeciality EventSpeciality @relation(fields: [specialityId], references:[id])
    specialityId Int

    recordGr RecordGroup[]
    recordInv RecordInvididual[]
}