
generator client {
  provider = "prisma-client-js"
  // output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  login     String   @unique
  password  String
  role      ROLES    @default(USER)
}

model Reviews {
  id        Int      @id @default(autoincrement())
  name      String
  title     String   @db.VarChar(255)
  stars     Int
  createdAt String
}

model Events {
  id              Int              @id @default(autoincrement())
  title           String           @db.VarChar(250)
  description     String           @db.VarChar(999)
  date            DateTime
  times           String
  duration        Int //В МИНУТАХ
  cabinet         String
  people_count    Int
  whoClasses      String
  isDelete        Boolean          @default(false)
  prepod          String
  createdAt       DateTime         @default(now())
  eventSpeciality EventSpeciality @relation(fields: [specialityId], references: [id])
  specialityId    Int
  recordGr  RecordGroup[]
  recordInv RecordInvididual[]
}

model EventSpeciality {
  id    Int    @id @default(autoincrement())
  title String 
  eventSpeciality Events[]
}

model RecordGroup {
  id                 Int      @id @default(autoincrement())
  school             String
  class              String
  firstNameAttendant String 
  lastNameAttendant  String 
  SurnameAttendant   String? 
  phone              String
  countPeople        Int 
  listPeople         String 
  createdAt          DateTime @default(now())

  //на какой записались
  events   Events? @relation(fields: [eventsId], references: [id])
  eventsId Int?
}

model RecordInvididual {
  id              Int      @id @default(autoincrement())
  firstName       String 
  lastName        String 
  surname         String? 
  school          String
  class           String
  telephoneNumber String
  createdAt       DateTime @default(now())
  events          Events?  @relation(fields: [eventsId], references: [id])
  eventsId        Int?
}



enum ROLES {
  ADMIN
  USER
}
